# Copy to .env and fill in real values. Placeholders only — never commit secrets.
# The backend reads this file from the project root; the browser never sees any of these values.

# development | production | test
APP_ENV=development
APP_VERSION=dev

# Supabase Postgres — Dashboard → Connect → "Session pooler" connection string (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Signs session tokens (HMAC). At least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-64-hex-chars
SESSION_TTL_DAYS=7
SESSION_MAX_AGE_DAYS=30
# Secure cookies turn on automatically when APP_ENV=production; only set this to override.
# COOKIE_SECURE=

# NVIDIA hosted models (OpenAI-compatible API). AI features disable themselves if the key is empty.
NVIDIA_API_KEY=replace-me
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# e.g. a Nemotron chat model from build.nvidia.com
NVIDIA_MODEL=replace-with-model-id
# reasoning on = slower, rarely needed for these tasks
NVIDIA_ENABLE_THINKING=false
# json_object (recommended) | json_schema | none
NVIDIA_STRUCTURED_OUTPUT=json_object
LLM_TIMEOUT_SECONDS=30

# AI usage controls
AI_HOURLY_LIMIT=30
AI_DAILY_LIMIT=150
AI_GLOBAL_DAILY_LIMIT=3000

# Uploads and safety
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=5
PII_REDACTION_ENABLED=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO
